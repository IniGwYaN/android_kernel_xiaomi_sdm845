+			/* buf->f_flags is already spoofed by
+			 * susfs_statfs_by_dentry(), do not rewrite it below. */
+			return susfs_statfs_by_dentry(path->dentry, buf, &is_fuse);
+		}
+	}
+#endif // #ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
